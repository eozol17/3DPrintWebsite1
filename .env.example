# Database - Use absolute path in production to avoid Prisma CLI vs runtime path mismatch
# Local: DATABASE_URL="file:./prisma/dev.db"
# Production (DigitalOcean): DATABASE_URL="file:/var/www/3DPrintWebsite1/prisma/prisma/dev.db"
DATABASE_URL="file:./prisma/dev.db"

# Admin panel password - CHANGE THIS in production!
ADMIN_PASSWORD="your-secure-password-here"

# Session secret for admin cookie signing - CHANGE THIS in production!
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="generate-a-long-random-string-here"
